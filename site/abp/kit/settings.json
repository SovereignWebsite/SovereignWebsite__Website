{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "Code Apache-2.0, text CC BY 4.0; adapted from an open-source implementation. ABP hook wiring; only the abp agent edits this file.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/abp.mjs\" session-start 2>/dev/null || true", "timeout": 15 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/abp.mjs\" prompt 2>/dev/null || true", "timeout": 10 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/abp.mjs\" pre-tool 2>/dev/null || true", "timeout": 10 }]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/abp.mjs\" pre-compact 2>/dev/null || true", "timeout": 10 }]
      }
    ]
  }
}
